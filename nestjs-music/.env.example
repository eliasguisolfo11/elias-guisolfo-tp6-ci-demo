# Ruta del catálogo Chinook. Sin valor se usa data/chinook.db desde el directorio de trabajo.
DATABASE_PATH=

# Ruta de la base SQLite independiente para cuentas; sin valor se usa data/auth.db.
AUTH_DATABASE_PATH=

# Ruta de la base SQLite independiente para reservas; sin valor se usa data/reservations.db.
RESERVATIONS_DATABASE_PATH=

# Ruta de coordinación SQLite para solicitudes idempotentes; sin valor se usa data/reservations-coordination.db.
RESERVATIONS_COORDINATION_DATABASE_PATH=

# Primera cuenta admin. Completá las tres variables solo en tu .env local.
AUTH_BOOTSTRAP_ADMIN_USERNAME=
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Secreto con el que se firman y verifican los JWT de escritura. No se versiona ningún
# valor: generá uno localmente y guardalo solo en tu .env (p. ej. openssl rand -hex 32).
JWT_SECRET=

# Vigencia de los tokens JWT (por defecto, 60 minutos).
JWT_EXPIRES_IN=60m

# Puerto en el que escucha la aplicación (src/main.ts lo lee con ConfigService; sin valor usa 3000).
PORT=3300

# NestJS Observe (https://observe.nestjs.com) - opcional.
# Copiá este archivo como .env y completá las claves desde el dashboard.
# Mientras estén vacías, la telemetría queda desactivada.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
